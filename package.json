{
  "name": "clinic",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "pnpm --filter @clinic/e2e test:e2e",
    "worker": "pnpm --filter @clinic/worker start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "depcruise packages apps --config .dependency-cruiser.cjs",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d --wait",
    "db:migrate": "pnpm --filter @clinic/db migrate:up",
    "db:seed": "pnpm --filter @clinic/core seed",
    "db:verify": "pnpm --filter @clinic/db verify:replica-set",
    "setup": "pnpm install && pnpm infra:up && pnpm db:migrate && pnpm db:seed",
    "verify": "pnpm lint && pnpm typecheck && pnpm graph && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
