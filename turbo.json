{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "eslint.config.js",
    "tsconfig.base.json",
    ".dependency-cruiser.cjs",
    ".prettierrc",
    "pnpm-lock.yaml",
    ".env.example"
  ],
  "globalEnv": [
    "NODE_ENV",
    "MONGODB_URI",
    "MONGODB_DB",
    "MONGODB_AUDIT_URI",
    "REDIS_URL",
    "AUTH_SECRET",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_REGION",
    "MAIL_FROM",
    "SMTP_URL",
    "APP_URL",
    "LOG_LEVEL"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "lint": { "dependsOn": ["^lint"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^build"], "outputs": ["coverage/**"] },
    "test:integration": { "cache": false }
  }
}
