# Copy to .env and adjust. Parsed once at boot by @clinic/config (section 13.1) —
# the process refuses to start if anything here is missing or malformed.

NODE_ENV=development
# Must match the address in the browser exactly: state-changing requests from any other
# origin are refused (section 16.1), so http://127.0.0.1:3000 will not work here.
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# One clinic per installation (ADR-0005). `pnpm db:seed` creates this clinic.
CLINIC_ID=seed_clinic_demo

# Set to true ONLY behind a proxy you control that sets X-Real-IP / X-Forwarded-For.
# Left false, client-sent forwarding headers are ignored and per-IP rate limits are
# skipped rather than fed a forgeable address (per-account lockout still applies).
TRUST_PROXY=false

# Demo password for the seeded users. Unset, the seed uses a documented default and
# refuses to run at all when NODE_ENV=production.
# SEED_PASSWORD=

# MongoDB MUST be a replica set. `?replicaSet=rs0` is not optional.
# Port 27018 (not the default) so this stack cannot collide with another local MongoDB.
MONGODB_URI=mongodb://localhost:27018/?replicaSet=rs0
MONGODB_DB=clinic

# Separate connection for audit writes (section 11.5). In production this user holds
# only insert+find on auditLogs; locally auth is off, so it is the same URI and the
# privilege separation is structural rather than enforced. See docs/adr/0016.
MONGODB_AUDIT_URI=mongodb://localhost:27018/?replicaSet=rs0

REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-only-secret-replace-me-with-32-bytes-minimum-abcdef

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=clinic-dev
S3_ACCESS_KEY=clinic
S3_SECRET_KEY=clinic-dev-secret
S3_REGION=us-east-1

SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@clinic.local
