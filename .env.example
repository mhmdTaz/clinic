# Copy to .env and adjust. Parsed once at boot by @clinic/config (section 13.1) —
# the process refuses to start if anything here is missing or malformed.

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# MongoDB MUST be a replica set. `?replicaSet=rs0` is not optional.
# Port 27018 (not the default) so this stack cannot collide with another local MongoDB.
MONGODB_URI=mongodb://localhost:27018/?replicaSet=rs0
MONGODB_DB=clinic

# Separate connection for audit writes (section 11.5). In production this user holds
# only insert+find on auditLogs; locally auth is off, so it is the same URI and the
# privilege separation is structural rather than enforced. See docs/adr/0016.
MONGODB_AUDIT_URI=mongodb://localhost:27018/?replicaSet=rs0

REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=dev-only-secret-replace-me-with-32-bytes-minimum-abcdef

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=clinic-dev
S3_ACCESS_KEY=clinic
S3_SECRET_KEY=clinic-dev-secret
S3_REGION=us-east-1

SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@clinic.local
